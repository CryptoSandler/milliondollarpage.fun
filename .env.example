# Postgres for the app, in every environment. Neon, branch `production`.
#
# Required, no default: a fallback would mean running against the wrong
# database rather than failing. Keep sslmode=verify-full: `require` encrypts
# but authenticates nothing, so it stops eavesdropping and not impersonation.
DATABASE_URL=

# Postgres for the TEST SUITE and nothing else. Neon, branch `tests`.
#
# Deliberately a different variable, and deliberately a different branch. The
# suite truncates every table between tests, so this must point at a database
# that is disposable on purpose. The suite refuses to start if it is the same
# as DATABASE_URL.
TEST_DATABASE_URL=

# Salts the hash of a caller's IP address before it is stored, so reservation
# limits can count callers without ever keeping a raw IP. Required, no
# default: an unsalted SHA-256 of an IPv4 address is reversible by brute
# force, so the stored hashes would be visitor IP addresses in all but name.
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Local-development escape hatch. `next dev` sits behind no proxy, so without
# this there is no trustworthy client address and every request is refused.
# Set to true in .env.local for local development only. Must never be set in
# production: it would let any caller claim an arbitrary identity and defeat
# the reservation limits entirely.
# ALLOW_UNTRUSTED_CLIENT_IP=true

# Lets `markPaid` accept a synthetic, unverified payment signature, so the
# order flow can be built and tested before a real payment verifier exists.
# Set to true in .env.local for local development and the test suite only.
# Must never be set in production: it would let anyone mark any order paid
# without sending any money. This flag disappears when batch 3 ships the real
# on-chain USDC verifier; src/lib/config.ts fails startup if it is set in
# production in the meantime.
# ALLOW_STUB_PAYMENTS=true
