# Postgres for the app, in every environment. Neon, branch `production`.
#
# Required, no default: a fallback would mean running against the wrong
# database rather than failing. Keep sslmode=verify-full: `require` encrypts
# but authenticates nothing, so it stops eavesdropping and not impersonation.
DATABASE_URL=

# Postgres for the TEST SUITE and nothing else. Neon, branch `tests`.
#
# Deliberately a different variable, and deliberately a different branch. The
# suite truncates every table between tests, so this must point at a database
# that is disposable on purpose. The suite refuses to start if it is the same
# as DATABASE_URL.
TEST_DATABASE_URL=

# Salts the hash of a caller's IP address before it is stored, so reservation
# limits can count callers without ever keeping a raw IP. Required, no
# default: an unsalted SHA-256 of an IPv4 address is reversible by brute
# force, so the stored hashes would be visitor IP addresses in all but name.
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Local-development escape hatch. `next dev` sits behind no proxy, so without
# this there is no trustworthy client address and every request is refused.
# Set to true in .env.local for local development only. Must never be set in
# production: it would collapse every caller into one shared rate-limit
# identity, and with a 3-hold ceiling per caller that makes the site
# unusable for everyone after the first few visitors — an outage, not just a
# weaker limit. src/lib/config.ts fails startup if it is set in production.
# ALLOW_UNTRUSTED_CLIENT_IP=true

# Lets `markPaid` accept a synthetic, unverified payment signature, so the
# order flow can be built and tested before a real payment verifier exists.
# Set to true in .env.local for local development and the test suite only.
# Must never be set in production: it would let anyone mark any order paid
# without sending any money. This flag disappears when batch 3 ships the real
# on-chain USDC verifier; src/lib/config.ts fails startup if it is set in
# production in the meantime.
# ALLOW_STUB_PAYMENTS=true

# The operator's admin token. Unset by default, and unset MEANS REFUSE: with
# no value here there is no admin surface at all — not an open one, not a
# partly open one, and not one a session cookie minted while it was set can
# still get into (src/lib/admin.ts, `adminConfigured`). Clearing it is
# therefore also how the surface is taken down in a hurry, at the cost of
# taking it down for the operator too. Never appears in a cookie: signing in
# exchanges it for a revocable session id. Generate with: openssl rand -hex 32
# ADMIN_TOKEN=

# Deploys and previews this project from the CLI, as the scope that owns it.
#
# NOT the machine's global `vercel login`: that is authenticated as a different
# account here and cannot see this project, which is how a preview deploy failed
# silently once. A token keeps the scope explicit and out of a shell's ambient
# state.
#
# Read-write on the Vercel project. It is not needed to run or test anything —
# only to deploy.
VERCEL_TOKEN=

# ── The Robinhood Chain payment rail (USDG) ───────────────────────────────────
#
# THE PUBLIC ADDRESS THAT RECEIVES THE MONEY. Not a key: SECURITY.md holds the
# repository to one private key and it is not this one. Empty on purpose — a
# default here would be somebody else's wallet, and every buyer would pay a
# stranger while the rectangles stayed unsold. `assertRobinhoodRailConfigured`
# refuses to boot a deployed instance that has the rail on and this empty, and
# refuses any instance where it is set but malformed.
ROBINHOOD_TREASURY_ADDRESS=

# The switch. The rail is off until this says otherwise, so setting the treasury
# to try something out cannot start taking money on its own.
# ROBINHOOD_PAYMENTS=true

# The node a payment is read back from. No fallback: a verifier that quietly
# read a different node than the operator configured — a testnet one, say — is
# how rectangles become free. Alchemy's Robinhood mainnet endpoint carries a
# provider key, which is why `robinhood-rpc.ts` is `server-only`.
ROBINHOOD_RPC_URL=

# The testnet, for the rehearsal only. Never read by the app: only by
# `scripts/rail-rehearsal.mts` and `scripts/usdg-check.mts --testnet`.
#
# The token is a DIFFERENT deployment from mainnet's — USDG's mainnet address
# has no code on 46630 — so it is named separately rather than assumed.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TOKEN_ADDRESS=
